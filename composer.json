{
    "name": "michal/pid-analyzer",
    "description": "Collect and analyze open data published by PID",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Core\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public"
        ],
        "repl": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./vendor/psy/psysh/bin/psysh"
        ],
        "tests": [
            "@php ./vendor/bin/pest --no-coverage"
        ],
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "@php ./vendor/bin/pest",
            "cat coverage/coverage.txt"
        ],
        "mutate": [
            "@putenv XDEBUG_MODE=coverage",
            "@php ./vendor/bin/pest --mutate"
        ],
        "loc": [
            "echo $(find core src tests -name '*.php' -exec cat {} + | wc -l | tr -d ' ') Lines written \uD83D\uDC68\uD83C\uDFFB\u200D\uD83D\uDCBB"
        ]
    },
    "authors": [
        {
            "name": "Michal Škoula",
            "email": "michal@skoula.com"
        }
    ],
    "require": {
        "vlucas/phpdotenv": "^5.8",
        "ext-pdo": "*"
    },
    "require-dev": {
        "psy/psysh": "^0.12.24",
        "php-debugbar/php-debugbar": "^3.8.1",
        "pestphp/pest": "^5.3",
        "symfony/var-dumper": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
