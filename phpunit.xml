<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Test Suite">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="memory_limit" value="2G"/>
    </php>
    <source>
        <include>
            <directory>app</directory>
            <directory>core</directory>
            <directory>src</directory>
        </include>

        <exclude>
            <directory>core/Routing/Controllers/Debug</directory>
<!--            <directory suffix="Controller.php">app/Debug</directory>-->
<!--            <file>core/helpers.php</file>-->
        </exclude>
    </source>
    <coverage branchCoverage="true">
        <report>
            <text outputFile="storage/coverage/coverage.txt" showUncoveredFiles="false"/>
            <html outputDirectory="public/coverage"/>
        </report>
    </coverage>
</phpunit>
